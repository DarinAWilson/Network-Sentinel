loki.source.file "suricata" {
  targets = [
    {
      __path__  = "/var/log/suricata/eve.json",
      job       = "suricata",
      host      = "server02",
      tenant_id = "NS-C001",
      node_id   = "NS-C001-01",
    },
  ]

  forward_to    = [loki.write.local.receiver]
  tail_from_end = true
}

loki.write "local" {
  endpoint {
    url = "http://telemetry-gateway:8080/loki/api/v1/push"
  }
}