loki.source.file "suricata" {
  targets = [
    {
      __path__  = "/var/log/suricata/eve.json",
      job       = "suricata-alloy",
      host      = "server02",
      tenant_id = "NS-C001",
      node_id   = "NS-C001-01",
    },
  ]

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}