loki.source.file "suricata" {
  targets = [
    {
      __path__  = "/var/log/suricata/eve.json",
      job       = "suricata",
      host      = "server02",
      tenant_id = "NS-C001",
      node_id   = "NS-C001-01",
    },
  ]

  forward_to    = [loki.write.local.receiver]
  tail_from_end = true
}

loki.write "local" {
  endpoint {
    url               = "https://telemetry-gateway:8443/loki/api/v1/push"
    bearer_token_file = "/run/secrets/telemetry-token"

    tls_config {
      ca_file = "/run/secrets/telemetry.crt"
    }
  }
}